<Window x:Class="NetworkWatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Watcher" Height="470" Width="760">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Settings" Margin="0,0,0,8">
            <StackPanel Margin="8">
                <CheckBox Name="ChkStartWithWindows" Content="Start NetworkWatcher automatically with Windows" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Identify ignored adapters by:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton Name="RbMatchById" Content="ID" GroupName="MatchMode" Margin="0,0,14,0" Checked="MatchMode_Checked"/>
                    <RadioButton Name="RbMatchByName" Content="Name" GroupName="MatchMode" Checked="MatchMode_Checked"/>
                </StackPanel>
                <TextBlock Text="Checked adapters are allowed and will not trigger the warning icon." Foreground="Gray" Margin="0,6,0,0"/>
            </StackPanel>
        </GroupBox>

        <ListView Name="AdaptersList" Grid.Row="1" Margin="0,0,0,8" ItemsSource="{Binding}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="30">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsIgnored, Mode=TwoWay}" ToolTip="Ignore this adapter"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="300"/>
                    <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="120"/>
                    <GridViewColumn Header="Status (Up)" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IsUp}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="160"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="BtnSave" Width="110" Height="28" Margin="4" Click="BtnSave_Click">Save settings</Button>
            <Button Name="BtnMinimize" Width="182" Height="28" Margin="4" Click="BtnMinimize_Click">Minimize to tray
            </Button>
        </StackPanel>
    </Grid>
</Window>
